# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Required app secrets
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/bleya
JWT_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Cloudflare R2
# Required in production.
# Also required in development if you want image uploads to work locally.
# If omitted in development, the backend still starts, but upload endpoints fail.
# -----------------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Image provider
# provider: pexels | wikidata
# pexels is attempted first and falls back to wikidata when the API key is missing
# or the provider is set to wikidata
# -----------------------------------------------------------------------------
IMAGE_SERVICE_PROVIDER=pexels
PEXELS_API_KEY=

# -----------------------------------------------------------------------------
# HTTP logging
# body mode: off | errors | all
# In local development, redact/truncate are forced off for easier debugging.
# -----------------------------------------------------------------------------
HTTP_LOG_BODY_MODE=all
HTTP_LOG_BODY_REDACT=false
HTTP_LOG_BODY_TRUNCATE=false
HTTP_LOG_BODY_MAX_BYTES=4096
