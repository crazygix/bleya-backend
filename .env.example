# -----------------------------------------------------------------------------
# Core runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
APP_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# URL configuration
# Keep the same keys across .env.local, .env.production, etc.
# Leave blank to derive from APP_HOST and PORT.
# Production example:
# PUBLIC_ORIGIN=https://api.bleyachat.com
# API_BASE_URL=https://api.bleyachat.com/v1
# CLIENT_ORIGIN=https://bleyachat.com
# -----------------------------------------------------------------------------
PUBLIC_ORIGIN=
API_BASE_URL=
CLIENT_ORIGIN=

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/bleya
JWT_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=365

# -----------------------------------------------------------------------------
# CORS
# Defaults to CLIENT_ORIGIN when left empty.
# Comma-separated origins for multi-client setups.
# -----------------------------------------------------------------------------
CORS_ORIGINS=
CORS_ALLOW_ALL_IN_DEV=true

# -----------------------------------------------------------------------------
# HTTP logging
# body mode: off | errors | all
# -----------------------------------------------------------------------------
HTTP_LOG_BODY_MODE=all
HTTP_LOG_BODY_REDACT=false
HTTP_LOG_BODY_TRUNCATE=false
HTTP_LOG_BODY_MAX_BYTES=4096
HTTP_LOG_BODY_REDACT_FIELDS=

# -----------------------------------------------------------------------------
# Cloudflare R2
# Use the same key in every environment file. Old keys remain supported as
# fallbacks, but R2_PUBLIC_BASE_URL is the preferred setting.
# -----------------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# City search tuning
# -----------------------------------------------------------------------------
CITY_SEARCH_RADIUS_KM=30
CITY_SEARCH_LIMIT=20
CITY_SEARCH_MAX_RADIUS_KM=100
CITY_SEARCH_MAX_LIMIT=50

# -----------------------------------------------------------------------------
# Image providers
# provider: wikidata | pexels
# -----------------------------------------------------------------------------
IMAGE_SERVICE_PROVIDER=wikidata
PEXELS_API_KEY=
