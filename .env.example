# -----------------------------------------------------------------------------
# Core runtime
# Tests (NODE_ENV=test) read only .env.test / .env.test.local, never this file's
# .env / .env.local, so live credentials can't leak into a test run.
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Required app secrets
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/bleya
JWT_SECRET=replace-with-a-long-random-secret
# Keys the hash that remembers banned sign-in identities after account deletion.
# Optional (derived from JWT_SECRET when empty); set it so rotating JWT_SECRET
# doesn't forget bans.
IDENTITY_HASH_SECRET=

# -----------------------------------------------------------------------------
# Auth providers and passkeys
# Google audience should be the Web client ID from Firebase / Google OAuth.
# Apple values depend on your Apple Developer Service ID setup.
# APPLE_ALLOWED_AUDIENCES should include the iOS bundle ID and, if Android
# Sign in with Apple is enabled, the Android Service ID as well.
# APPLE_ANDROID_REDIRECT_PATH is the absolute backend callback path that Apple
# redirects to, so production becomes https://api.bleyachat.com<path>.
# PASSKEY_EXPECTED_ORIGINS lists the exact origins passkeys may come from,
# comma-separated, with no quotes and no trailing slash: https://<PASSKEY_RP_ID>
# for iOS, plus android:apk-key-hash:<hash> for every certificate the Android
# app is signed with (in production the Play app signing key and the upload
# key; locally the debug key). <hash> is the certificate's SHA-256 in base64url
# without padding. From the SHA-256 that Play Console or keytool prints:
#   FP='AA:BB:…'; echo "android:apk-key-hash:$(echo "$FP" | tr -d ':' | xxd -r -p | base64 | tr '+/' '-_' | tr -d '=')"
# Empty means https://<PASSKEY_RP_ID> only. In production, startup logs
# config.passkey_origins when the list looks wrong.
# -----------------------------------------------------------------------------
GOOGLE_ALLOWED_AUDIENCES=53564262386-fhqi82mun45qrnojia90kc4dkmg1a5n6.apps.googleusercontent.com
APPLE_ALLOWED_AUDIENCES=com.bleyachat,com.bleyachat.signin
APPLE_ANDROID_SERVICE_ID=com.bleyachat.signin
APPLE_ANDROID_REDIRECT_PATH=/v1/auth/apple/android/callback
ANDROID_PACKAGE_NAME=com.bleyachat
PASSKEY_RP_ID=bleyachat.com
PASSKEY_RP_NAME=Bleya
PASSKEY_EXPECTED_ORIGINS=https://bleyachat.com,android:apk-key-hash:<play-app-signing-key-hash>,android:apk-key-hash:<upload-key-hash>
# Apple sign-in always requires a matching nonce. Set to true once the app also
# sends a nonce for Google sign-in, to require it there as well.
REQUIRE_PROVIDER_NONCE=false

# -----------------------------------------------------------------------------
# Networking / realtime
# TRUSTED_PROXY_CIDRS: extra proxy ranges to trust for the client IP, on top of
# Cloudflare's (comma-separated CIDRs).
# SOCKET_ENFORCE_TOKEN_EXPIRY: disconnect sockets when their access token
# expires. Enable once the app reconnects with a fresh token by itself.
# SOCKET_MAX_CONNECTIONS_PER_USER: newest connection wins beyond this.
# -----------------------------------------------------------------------------
TRUSTED_PROXY_CIDRS=
SOCKET_ENFORCE_TOKEN_EXPIRY=false
SOCKET_MAX_CONNECTIONS_PER_USER=5

# -----------------------------------------------------------------------------
# Cloudflare R2
# Required in production.
# Also required in development if you want image uploads to work locally.
# If omitted in development, the backend still starts, but upload endpoints fail.
# -----------------------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Image provider
# provider: pexels | wikidata
# pexels is attempted first and falls back to wikidata when the API key is missing
# or the provider is set to wikidata
# -----------------------------------------------------------------------------
IMAGE_SERVICE_PROVIDER=pexels
PEXELS_API_KEY=

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging
# Required in production.
# If omitted in development, push notifications stay disabled.
# FIREBASE_PRIVATE_KEY should preserve embedded newlines as \n.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# HTTP logging
# body mode: off | errors | all
# In local development, redact/truncate are forced off for easier debugging.
# -----------------------------------------------------------------------------
HTTP_LOG_BODY_MODE=all
HTTP_LOG_BODY_REDACT=false
HTTP_LOG_BODY_TRUNCATE=false
HTTP_LOG_BODY_MAX_BYTES=4096

# -----------------------------------------------------------------------------
# Moderation / admin API ( /v1/admin )
# ADMIN_API_KEY gates the admin endpoints. Leave empty to keep the admin surface
# disabled (fail-closed). Set a random string of at least 32 characters to
# enable it (shorter keys are refused); the web admin panel sends it as the
# `x-admin-key` header.
# ADMIN_DASHBOARD_ORIGIN: if you host a separate web admin panel, set its origin
# (e.g. https://admin.bleyachat.com) so browser calls pass CORS.
# -----------------------------------------------------------------------------
ADMIN_API_KEY=
ADMIN_DASHBOARD_ORIGIN=

# -----------------------------------------------------------------------------
# Sign in with Apple — token revocation on account deletion (Guideline 5.1.1(v))
# All four required to enable; leave empty to disable (no-op).
# APPLE_REVOKE_CLIENT_ID is the default client_id for Sign in with Apple (the iOS
# app bundle id, e.g. com.bleyachat); Android sign-ins use the Services ID from
# their ID token automatically. APPLE_PRIVATE_KEY is the .p8 contents with
# newlines escaped as \n. Requires the mobile app to send `authorizationCode`.
# -----------------------------------------------------------------------------
APPLE_REVOKE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Content filter (post-time moderation)
# CONTENT_BLOCKLIST: comma-separated terms to block in messages/usernames/bios,
# on top of the built-in starter list. POPULATE before launch (slurs etc.).
# Terms match whole words; '*' is a wildcard: 'word*' = starts with,
# '*word' = ends with, '*word*' = contains. Multi-word terms match word runs.
# Image moderation: set provider + key to enable an image-safety check on uploads
# (no-op while empty).
# -----------------------------------------------------------------------------
CONTENT_BLOCKLIST=
IMAGE_MODERATION_PROVIDER=
IMAGE_MODERATION_API_KEY=
IMAGE_MODERATION_API_SECRET=
