{
  "name": "bleya",
  "version": "1.0.0",
  "description": "Bleya group chat",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server/server.js",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "start": "node dist/server/server.js",
    "dev": "nodemon",
    "test": "npm run build && NODE_ENV=test node --test --test-concurrency=1 dist/tests/**/*.test.js",
    "test:isolated": "npm run build && node scripts/run-tests-isolated.mjs",
    "build": "rm -rf dist && tsc",
    "migrate:seed-rooms": "npm run build && node dist/migrations/001_seed_public_rooms.js",
    "migrate:drop-legacy-room-index": "npm run build && node dist/migrations/002_drop_legacy_room_name_index.js",
    "migrate:normalize-user-refs": "npm run build && node dist/migrations/003_normalize_user_references.js",
    "migrate:dedupe-rooms": "npm run build && node dist/migrations/004_dedupe_rooms_and_build_indexes.js",
    "migrate:unescape-text": "npm run build && node dist/migrations/005_unescape_stored_text.js",
    "migrate:neutral-dm-names": "npm run build && node dist/migrations/006_neutral_dm_room_names.js",
    "migrate:reencode-profile-images": "npm run build && node dist/migrations/007_reencode_profile_images.js",
    "migrate:report-retention": "npm run build && node dist/migrations/008_report_retention.js",
    "db": "npm run build && node dist/scripts/db.js",
    "diagnose-push": "npm run build && node dist/scripts/diagnose-push.js",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.24",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^7.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@simplewebauthn/server": "^13.2.2",
    "body-parser": "^1.20.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.2.0",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1"
  }
}
