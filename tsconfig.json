{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "rootDir": ".",
    "sourceMap": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
  },
  "include": [
    "config/**/*",
    "server/**/*",
    "routes/**/*",
    "middleware/**/*",
    "models/**/*",
    "services/**/*",
    "utils/**/*",
    "repositories/**/*",
    "migrations/**/*",
    "scripts/**/*",
    "tests/**/*"
  ]
}